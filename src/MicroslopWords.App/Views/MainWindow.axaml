<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MicroslopWords.App.Controls"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:vm="using:MicroslopWords.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="MicroslopWords.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="840"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D0" Command="{Binding FitWidthCommand}" />
        <KeyBinding Gesture="Meta+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Meta+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Meta+D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Gesture="Meta+Shift+D0" Command="{Binding FitWidthCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Meta+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Meta+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Meta+X" Command="{Binding CutCommand}" />
        <KeyBinding Gesture="Meta+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Meta+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Meta+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleBoldCommand}" />
        <KeyBinding Gesture="Ctrl+I" Command="{Binding ToggleItalicCommand}" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding ToggleUnderlineCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+X" Command="{Binding ToggleStrikethroughCommand}" />
        <KeyBinding Gesture="Meta+B" Command="{Binding ToggleBoldCommand}" />
        <KeyBinding Gesture="Meta+I" Command="{Binding ToggleItalicCommand}" />
        <KeyBinding Gesture="Meta+U" Command="{Binding ToggleUnderlineCommand}" />
        <KeyBinding Gesture="Meta+Shift+X" Command="{Binding ToggleStrikethroughCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding InsertPageBreakCommand}" />
        <KeyBinding Gesture="Meta+Enter" Command="{Binding InsertPageBreakCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+Shift+S" Command="{Binding ToggleStylesPanelCommand}" />
        <KeyBinding Gesture="Meta+Alt+Shift+S" Command="{Binding ToggleStylesPanelCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open..." Command="{Binding OpenDocumentCommand}" />
                <MenuItem Header="_Save" Command="{Binding SaveDocumentCommand}" />
                <MenuItem Header="Save _As..." Command="{Binding SaveDocumentAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" />
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" />
                <Separator />
                <MenuItem Header="_Find" Command="{Binding FindCommand}" />
            </MenuItem>
            <MenuItem Header="_Insert" IsEnabled="{Binding IsEditingEnabled}">
                <MenuItem Header="_Table" />
                <MenuItem Header="_Image..." />
                <MenuItem Header="Page _Break" />
            </MenuItem>
            <MenuItem Header="_Format" IsEnabled="{Binding IsEditingEnabled}">
                <MenuItem Header="_Bold" Command="{Binding ToggleBoldCommand}" />
                <MenuItem Header="_Italic" Command="{Binding ToggleItalicCommand}" />
                <MenuItem Header="_Underline" Command="{Binding ToggleUnderlineCommand}" />
                <MenuItem Header="_Strikethrough" Command="{Binding ToggleStrikethroughCommand}" />
                <Separator />
                <MenuItem Header="Align _Left" Command="{Binding AlignLeftCommand}" />
                <MenuItem Header="Align _Center" Command="{Binding AlignCenterCommand}" />
                <MenuItem Header="Align _Right" Command="{Binding AlignRightCommand}" />
                <MenuItem Header="Align _Justify" Command="{Binding AlignJustifyCommand}" />
                <Separator />
                <MenuItem Header="_Bulleted List" Command="{Binding ToggleBulletedListCommand}" />
                <MenuItem Header="_Numbered List" Command="{Binding ToggleNumberedListCommand}" />
                <MenuItem Header="Increase List _Level" Command="{Binding IncreaseListLevelCommand}" />
                <MenuItem Header="Decrease List L_evel" Command="{Binding DecreaseListLevelCommand}" />
                <MenuItem Header="_Restart Numbering" Command="{Binding RestartNumberingCommand}" />
                <MenuItem Header="Page _Break" Command="{Binding InsertPageBreakCommand}" />
                <Separator />
                <MenuItem Header="Clear Character Formatting" Command="{Binding ClearCharacterFormattingCommand}" />
                <MenuItem Header="Clear _Paragraph Formatting" Command="{Binding ClearParagraphFormattingCommand}" />
                <Separator />
                <MenuItem Header="_Styles" Command="{Binding ToggleStylesPanelCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="_100%" Command="{Binding ResetZoomCommand}" />
                <Separator />
                <MenuItem Header="Fit _Width" Command="{Binding FitWidthCommand}" />
                <MenuItem Header="Fit _Page" Command="{Binding FitPageCommand}" />
                <Separator />
                <MenuItem Header="_Styles" Command="{Binding ToggleStylesPanelCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About MicroslopWords" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="New" Command="{Binding NewDocumentCommand}" />
                <Button Content="Open" Command="{Binding OpenDocumentCommand}" />
                <Button Content="Save" Command="{Binding SaveDocumentCommand}" />
                <Button Content="Save As" Command="{Binding SaveDocumentAsCommand}" />
                <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="6,0" />
                <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding IsEditingEnabled}">
                    <ToggleButton x:Name="BoldToggle"
                                  Content="B"
                                  FontWeight="Bold"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsBoldSelected, Mode=OneWay}"
                                  Command="{Binding ToggleBoldCommand}"
                                  automation:AutomationProperties.Name="Bold" />
                    <ToggleButton x:Name="ItalicToggle"
                                  Content="I"
                                  FontStyle="Italic"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsItalicSelected, Mode=OneWay}"
                                  Command="{Binding ToggleItalicCommand}"
                                  automation:AutomationProperties.Name="Italic" />
                    <ToggleButton Content="U"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsUnderlineSelected, Mode=OneWay}"
                                  Command="{Binding ToggleUnderlineCommand}"
                                  automation:AutomationProperties.Name="Underline" />
                    <ToggleButton Content="S"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsStrikethroughSelected, Mode=OneWay}"
                                  Command="{Binding ToggleStrikethroughCommand}"
                                  automation:AutomationProperties.Name="Strikethrough" />
                    <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="4,0" />
                    <TextBox Width="110"
                             Text="{Binding FontFamilyInput, Mode=TwoWay}"
                             PlaceholderText="Font family"
                             automation:AutomationProperties.Name="Font family" />
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsFontFamilyMixed}" />
                    <Button Content="Set" Command="{Binding ApplyFontFamilyCommand}" ToolTip.Tip="Apply font family" />
                    <TextBox Width="54"
                             Text="{Binding FontSizeInput, Mode=TwoWay}"
                             PlaceholderText="pt"
                             automation:AutomationProperties.Name="Font size" />
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsFontSizeMixed}" />
                    <Button Content="Set" Command="{Binding ApplyFontSizeCommand}" ToolTip.Tip="Apply font size" />
                    <TextBox Width="86"
                             Text="{Binding ColorInput, Mode=TwoWay}"
                             PlaceholderText="#RRGGBB"
                             automation:AutomationProperties.Name="Text color" />
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsColorMixed}" />
                    <Button Content="Set" Command="{Binding ApplyColorCommand}" ToolTip.Tip="Apply text color" />
                    <TextBox Width="86"
                             Text="{Binding HighlightInput, Mode=TwoWay}"
                             PlaceholderText="Highlight"
                             automation:AutomationProperties.Name="Highlight color" />
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsHighlightMixed}" />
                    <Button Content="Set" Command="{Binding ApplyHighlightCommand}" ToolTip.Tip="Apply highlight" />
                    <Button Content="Clear" Command="{Binding ClearCharacterFormattingCommand}" ToolTip.Tip="Clear character formatting" />
                </StackPanel>
                <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="6,0" />
                <Button x:Name="StylesPanelButton"
                        Content="Styles"
                        Command="{Binding ToggleStylesPanelCommand}"
                        automation:AutomationProperties.Name="Styles panel" />
                <Button Content="Find" Command="{Binding FindCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F9F9F9" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="10,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding IsEditingEnabled}">
                    <ComboBox x:Name="StylePicker"
                              Width="150"
                              ItemsSource="{Binding StyleItems}"
                              SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                              automation:AutomationProperties.Name="Paragraph style">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StyleListItem">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsStyleMixed}" />
                    <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="4,0" />
                    <Button Content="Left" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align left" automation:AutomationProperties.Name="Align left" />
                    <Button x:Name="AlignCenterButton" Content="Center" Command="{Binding AlignCenterCommand}" ToolTip.Tip="Align center" automation:AutomationProperties.Name="Align center" />
                    <Button Content="Right" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align right" automation:AutomationProperties.Name="Align right" />
                    <Button Content="Justify" Command="{Binding AlignJustifyCommand}" ToolTip.Tip="Justify" automation:AutomationProperties.Name="Justify" />
                    <TextBlock Text="Mixed" FontSize="11" Foreground="#666666" VerticalAlignment="Center" IsVisible="{Binding IsAlignmentMixed}" />
                    <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="4,0" />
                    <ToggleButton x:Name="BulletedListToggle"
                                  Content="Bullets"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsBulletedList, Mode=OneWay}"
                                  Command="{Binding ToggleBulletedListCommand}"
                                  automation:AutomationProperties.Name="Bulleted list" />
                    <ToggleButton x:Name="NumberedListToggle"
                                  Content="Numbering"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsNumberedList, Mode=OneWay}"
                                  Command="{Binding ToggleNumberedListCommand}"
                                  automation:AutomationProperties.Name="Numbered list" />
                    <Button Content="Level -" Command="{Binding DecreaseListLevelCommand}" ToolTip.Tip="Decrease list level" />
                    <Button Content="Level +" Command="{Binding IncreaseListLevelCommand}" ToolTip.Tip="Increase list level" />
                    <Button Content="Restart" Command="{Binding RestartNumberingCommand}" ToolTip.Tip="Restart numbering" />
                    <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="4,0" />
                    <TextBox Width="52" Text="{Binding SpaceBeforeInput, Mode=TwoWay}" automation:AutomationProperties.Name="Space before" />
                    <Button Content="Set" Command="{Binding ApplySpaceBeforeCommand}" ToolTip.Tip="Apply space before" />
                    <TextBox Width="52" Text="{Binding SpaceAfterInput, Mode=TwoWay}" automation:AutomationProperties.Name="Space after" />
                    <Button Content="Set" Command="{Binding ApplySpaceAfterCommand}" ToolTip.Tip="Apply space after" />
                    <TextBox Width="52" Text="{Binding LineSpacingInput, Mode=TwoWay}" automation:AutomationProperties.Name="Line spacing" />
                    <Button Content="Set" Command="{Binding ApplyLineSpacingCommand}" ToolTip.Tip="Apply line spacing" />
                    <TextBox Width="52" Text="{Binding LeftIndentInput, Mode=TwoWay}" automation:AutomationProperties.Name="Left indent" />
                    <Button Content="Set" Command="{Binding ApplyLeftIndentCommand}" ToolTip.Tip="Apply left indent" />
                    <TextBox Width="52" Text="{Binding RightIndentInput, Mode=TwoWay}" automation:AutomationProperties.Name="Right indent" />
                    <Button Content="Set" Command="{Binding ApplyRightIndentCommand}" ToolTip.Tip="Apply right indent" />
                    <TextBox Width="52" Text="{Binding FirstLineIndentInput, Mode=TwoWay}" automation:AutomationProperties.Name="First line indent" />
                    <Button Content="Set" Command="{Binding ApplyFirstLineIndentCommand}" ToolTip.Tip="Apply first-line indent" />
                    <TextBox Width="52" Text="{Binding HangingIndentInput, Mode=TwoWay}" automation:AutomationProperties.Name="Hanging indent" />
                    <Button Content="Set" Command="{Binding ApplyHangingIndentCommand}" ToolTip.Tip="Apply hanging indent" />
                    <TextBlock Text="Mixed" FontSize="11" Foreground="#666666" VerticalAlignment="Center" IsVisible="{Binding AreParagraphValuesMixed}" />
                    <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="4,0" />
                    <Button x:Name="PageBreakButton" Content="Page break" Command="{Binding InsertPageBreakCommand}" automation:AutomationProperties.Name="Insert page break" />
                    <Button Content="Clear" Command="{Binding ClearParagraphFormattingCommand}" ToolTip.Tip="Clear paragraph formatting" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#EAF3FF"
                BorderBrush="#C8DDF7"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsReadOnly}">
            <TextBlock Text="This document contains content that cannot be edited safely yet, so it opens read-only."
                       FontSize="12"
                       Foreground="#24527A"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#FDECEA"
                BorderBrush="#F3B8B2"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#8A1F11"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#FFF4CE"
                BorderBrush="#E8D48B"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding HasDiagnostics}">
            <TextBlock Text="{Binding DiagnosticsSummary}"
                       FontSize="12"
                       Foreground="#5F4B00"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#F7F7F7"
                BorderBrush="#D8D8D8"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsProgressVisible}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressBar Width="180" IsIndeterminate="True" />
                <TextBlock Text="Opening document..." FontSize="12" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding OpenDocumentCancelCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#F7F7F7"
                BorderBrush="#D8D8D8"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsSaving}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressBar Width="180" IsIndeterminate="True" />
                <TextBlock Text="Saving document..." FontSize="12" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelSaveCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SaveStateText}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DocumentTitle}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="16" Fill="#D8D8D8" />
                    <Button Content="-" Command="{Binding ZoomOutCommand}" Width="24" Height="24" Padding="0" />
                    <TextBlock Text="{Binding ZoomPercentText}" FontSize="12" Foreground="#666666" MinWidth="42" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" Width="24" Height="24" Padding="0" />
                    <Button Content="Fit" Command="{Binding FitWidthCommand}" Height="24" Padding="8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="StylesPanel"
                DockPanel.Dock="Right"
                Width="264"
                Background="#F7F7F7"
                BorderBrush="#D8D8D8"
                BorderThickness="1,0,0,0"
                Padding="12"
                IsVisible="{Binding IsStylesPanelOpen}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="Styles" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding CurrentParagraphStyleName}"
                               FontSize="12"
                               Foreground="#333333" />
                    <TextBlock Text="{Binding CurrentCharacterStyleName}"
                               FontSize="11"
                               Foreground="#666666" />
                    <TextBlock Text="Mixed"
                               FontSize="11"
                               Foreground="#666666"
                               IsVisible="{Binding IsStyleMixed}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                    <StackPanel Spacing="4" IsVisible="{Binding IsStyleEditorOpen}">
                        <TextBox Text="{Binding StyleEditorName, Mode=TwoWay}"
                                 automation:AutomationProperties.Name="Style name" />
                        <ComboBox ItemsSource="{Binding StyleKinds}"
                                  SelectedItem="{Binding StyleEditorKind, Mode=TwoWay}"
                                  IsEnabled="{Binding IsStyleKindEditable}"
                                  automation:AutomationProperties.Name="Style kind" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Save" Command="{Binding SaveStyleCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelStyleEditorCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsStyleDeleteConfirmationOpen}">
                        <TextBlock Text="{Binding StyleDeletePrompt}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Delete" Command="{Binding ConfirmDeleteStyleCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelDeleteStyleCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding IsEditingEnabled}">
                        <Button Content="New" Command="{Binding NewStyleCommand}" />
                        <Button Content="Modify" Command="{Binding ModifyStyleCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteStyleCommand}" />
                    </StackPanel>
                    <Button Content="Update from selection"
                            Command="{Binding UpdateStyleFromSelectionCommand}"
                            IsEnabled="{Binding IsEditingEnabled}"
                            automation:AutomationProperties.Name="Update style from selection" />
                </StackPanel>

                <ListBox x:Name="StyleList"
                         ItemsSource="{Binding StyleItems}"
                         SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                         IsEnabled="{Binding IsEditingEnabled}"
                         automation:AutomationProperties.Name="Document styles">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StyleListItem">
                            <Grid ColumnDefinitions="36,*" ColumnSpacing="6">
                                <TextBlock Text="Aa"
                                           FontSize="{Binding PreviewDisplaySize}"
                                           FontWeight="{Binding PreviewWeight}"
                                           FontStyle="{Binding PreviewStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                    <TextBlock Text="{Binding PreviewDescription}"
                                               FontSize="10"
                                               Foreground="#666666" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#E8E8E8">
            <controls:DocumentPreviewControl x:Name="PageCanvas"
                                             Layout="{Binding Layout}"
                                             Document="{Binding Document}"
                                             Selection="{Binding Selection, Mode=TwoWay}"
                                             IsEditable="{Binding IsEditingEnabled}"
                                             EditorHost="{Binding}"
                                             Zoom="{Binding Zoom, Mode=TwoWay}"
                                             CurrentPage="{Binding CurrentPage, Mode=OneWayToSource}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
