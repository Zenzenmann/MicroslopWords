<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MicroslopWords.App.Controls"
        xmlns:vm="using:MicroslopWords.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="MicroslopWords.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="840"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open..." Command="{Binding OpenDocumentCommand}" />
                <MenuItem Header="_Save" Command="{Binding SaveDocumentCommand}" />
                <MenuItem Header="Save _As..." Command="{Binding SaveDocumentAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" IsEnabled="False" />
                <MenuItem Header="_Redo" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Find" Command="{Binding FindCommand}" />
            </MenuItem>
            <MenuItem Header="_Insert" IsEnabled="{Binding IsEditingEnabled}">
                <MenuItem Header="_Table" />
                <MenuItem Header="_Image..." />
                <MenuItem Header="Page _Break" />
            </MenuItem>
            <MenuItem Header="_Format" IsEnabled="{Binding IsEditingEnabled}">
                <MenuItem Header="_Bold" Command="{Binding ToggleBoldCommand}" />
                <MenuItem Header="_Italic" Command="{Binding ToggleItalicCommand}" />
                <MenuItem Header="_Underline" Command="{Binding ToggleUnderlineCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About MicroslopWords" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="New" Command="{Binding NewDocumentCommand}" />
                <Button Content="Open" Command="{Binding OpenDocumentCommand}" />
                <Button Content="Save" Command="{Binding SaveDocumentCommand}" />
                <Button Content="Save As" Command="{Binding SaveDocumentAsCommand}" />
                <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="6,0" />
                <Button Content="B" FontWeight="Bold" Command="{Binding ToggleBoldCommand}" />
                <Button Content="I" FontStyle="Italic" Command="{Binding ToggleItalicCommand}" />
                <Button Content="U" Command="{Binding ToggleUnderlineCommand}" />
                <Rectangle Width="1" Height="24" Fill="#D8D8D8" Margin="6,0" />
                <Button Content="Find" Command="{Binding FindCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#EAF3FF" BorderBrush="#C8DDF7" BorderThickness="0,0,0,1" Padding="10,6">
            <TextBlock Text="Read-only preview - editing is not available yet. Save a copy is available."
                       FontSize="12"
                       Foreground="#24527A" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#FDECEA"
                BorderBrush="#F3B8B2"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#8A1F11"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#FFF4CE"
                BorderBrush="#E8D48B"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding HasDiagnostics}">
            <TextBlock Text="{Binding DiagnosticsSummary}"
                       FontSize="12"
                       Foreground="#5F4B00"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#F7F7F7"
                BorderBrush="#D8D8D8"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsProgressVisible}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressBar Width="180" IsIndeterminate="True" />
                <TextBlock Text="Opening document..." FontSize="12" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding OpenDocumentCancelCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#F7F7F7"
                BorderBrush="#D8D8D8"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding IsSaving}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressBar Width="180" IsIndeterminate="True" />
                <TextBlock Text="Saving document..." FontSize="12" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelSaveCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding SaveStateText}" FontSize="12" Foreground="#666666" />
                    <TextBlock Text="{Binding DocumentTitle}" FontSize="12" Foreground="#666666" />
                    <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="#666666" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#E8E8E8">
            <controls:DocumentPreviewControl Layout="{Binding Layout}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
